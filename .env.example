# Copier ce fichier en .env.local, puis renseigner les deux valeurs ci-dessous.
# Ces variables sont intégrées au bundle navigateur : utiliser UNIQUEMENT la clé
# publiable (sb_publishable_...) ou anon. Jamais la clé service_role/secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Options de paiement prévues (aucun encaissement n'est implémenté aujourd'hui).
VITE_PAYMENT_CARTE=
VITE_PAYMENT_MOOV_MONEY=
VITE_PAYMENT_MTN_MOMO=
VITE_PAYMENT_ORANGE_MONEY=
VITE_PAYMENT_VIREMENT=
VITE_PAYMENT_WAVE=
