# Public browser configuration: replace with the project URL and publishable key.
# Never put a service_role key, secret key or Gemini API key in VITE_ variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Méthodes de paiement activées dans l'onglet Caisse.
# Par défaut, seul le paiement en espèces (especes) est actif.
# Définir chaque variable à "true" pour activer le mode correspondant.
VITE_PAYMENT_WAVE=true
VITE_PAYMENT_ORANGE_MONEY=true
VITE_PAYMENT_MTN_MOMO=true
VITE_PAYMENT_MOOV_MONEY=true
VITE_PAYMENT_CARTE=true
VITE_PAYMENT_VIREMENT=true
